# ------------------------------------------------------------------
# Morocco Retail Intelligence Data Platform — example environment file
# Copy to `.env` and fill in local values. NEVER commit the real .env.
# All values below are placeholders, not credentials.
# ------------------------------------------------------------------

# --- PostgreSQL (containerized, host port 5433 to avoid clashing with
# --- the native PostgreSQL 16/18 Windows services on port 5432) ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_ADMIN_USER=

# --- dbt target (PostgreSQL warehouse) ---
DBT_TARGET_HOST=
DBT_TARGET_PORT=
DBT_TARGET_DB=
DBT_TARGET_USER=
DBT_TARGET_PASSWORD=

# --- MinIO / S3-compatible object storage ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_RAW=
MINIO_BUCKET_BRONZE=
MINIO_CONSOLE_URL=

# --- Apache Airflow (official container image) ---
AIRFLOW_UID=
AIRFLOW_WEBSERVER_PORT=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW__CORE__FERNET_KEY=

# --- Apache Superset (official container image) ---
SUPERSET_SECRET_KEY=
SUPERSET_PORT=
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASSWORD=

# --- External public APIs (no API key required) ---
OPEN_METEO_BASE_URL=
OPEN_METEO_CACHE_DIR=
FRANKFURTER_BASE_URL=
OPEN_FOOD_FACTS_BASE_URL=

# --- Synthetic data generation ---
SYNTHETIC_SEED=
SYNTHETIC_OUTPUT_DIR=

# --- CI / misc ---
LOG_LEVEL=
