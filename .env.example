# ------------------------------------------------------------------
# Morocco Retail Intelligence Data Platform - example environment file
# Copy to `.env` and fill in local values. NEVER commit the real .env.
# All values below are placeholders, not credentials.
# ------------------------------------------------------------------

# --- PostgreSQL (containerized, host port 5433 to avoid clashing with
# --- the native PostgreSQL 16/18 Windows services on port 5432) ---
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
# Application/owner role: owns the retail database + user objects and issues
# all pipeline DDL, but is NOT a superuser (least privilege, PHASE 24).
POSTGRES_USER=
POSTGRES_PASSWORD=
# Break-glass administrator role (SUPERUSER, created by the initdb bootstrap
# hand-off in PHASE 24). Only used for role/database provisioning and manual
# recovery; NEVER wired into the application or BI.
POSTGRES_ADMIN_USER=
POSTGRES_ADMIN_PASSWORD=
POSTGRES_SSLMODE=

# --- Silver layer + warehouse schemas (PostgreSQL) ---
# raw_staging = bulk COPY landing (no constraints), silver = constrained
# tables, audit = load_audit registry + reconciliation, warehouse =
# Kimball star schema (7 dimensions, 3 facts).
PG_STAGING_SCHEMA=
PG_SILVER_SCHEMA=
PG_AUDIT_SCHEMA=
PG_WAREHOUSE_SCHEMA=

# --- dbt target (PostgreSQL warehouse) ---
DBT_TARGET_HOST=
DBT_TARGET_PORT=
DBT_TARGET_DB=
DBT_TARGET_USER=
DBT_TARGET_PASSWORD=
DBT_TARGET_SSLMODE=

# --- MinIO / S3-compatible object storage ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_RAW=
MINIO_BUCKET_BRONZE=
MINIO_CONSOLE_URL=

# --- Apache Airflow (PHASE 11: official 3.3.2 containers, LocalExecutor) ---
# AIRFLOW_UID is unused on Windows/macOS Docker Desktop (Linux file ownership).
AIRFLOW_UID=
# Host port for the Airflow UI (http://localhost:<port>).
AIRFLOW_WEBSERVER_PORT=
# Web UI / API admin account created by airflow-init.
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=
# Fernet key protecting Airflow connections/variables at rest (generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AIRFLOW__CORE__FERNET_KEY=
# Dedicated Airflow metadata database (NEVER the retail warehouse database).
# Host address/port for host-side tools; inside the compose network the
# services always use the service name `airflow-postgres:5432`.
AIRFLOW_POSTGRES_HOST=
AIRFLOW_POSTGRES_PORT=
AIRFLOW_POSTGRES_DB=
AIRFLOW_POSTGRES_USER=
AIRFLOW_POSTGRES_PASSWORD=
# JWT secret shared by the API server, scheduler and task runners (generate a
# long random string).
AIRFLOW_JWT_SECRET=
# Schedule for morocco_retail_pipeline (cron, UTC; empty = default "0 4 * * *").
MRI_DAG_SCHEDULE=

# --- Apache Superset (PHASE 12: official 6.1.0 image, SQLite metadata) ---
# Flask session/CSRF secret (generate a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))" ).
SUPERSET_SECRET_KEY=
# Host port for the Superset UI (http://localhost:<port>).
SUPERSET_PORT=
# Web UI / API admin account created by superset-init.
SUPERSET_ADMIN_USER=
SUPERSET_ADMIN_PASSWORD=
# Read-only PostgreSQL role Superset uses for ALL warehouse queries
# (SELECT only; grants applied by infrastructure/sql/bi-reader-readonly.sql).
# NEVER the POSTGRES_USER admin role.
BI_READER_USER=
BI_READER_PASSWORD=

# --- External public APIs (keyless; no secrets, all values optional) ---
# Base URLs (empty = provider default; override only for tests/mirrors).
OPEN_METEO_BASE_URL=
OPEN_METEO_ARCHIVE_BASE_URL=
OPEN_METEO_CACHE_DIR=
FRANKFURTER_BASE_URL=
OPEN_FOOD_FACTS_BASE_URL=
# Politeness: contact + client identity sent to every provider (Open Food
# Facts requires a custom User-Agent with a contact address).
EXTERNAL_CONTACT_EMAIL=
EXTERNAL_USER_AGENT=
# Retry/rate-limit behaviour (empty = built-in defaults).
EXTERNAL_RAW_PREFIX=
EXTERNAL_TIMEOUT_SECONDS=
EXTERNAL_MAX_ATTEMPTS=
OPEN_FOOD_FACTS_MIN_INTERVAL=

# --- Synthetic data generation ---
SYNTHETIC_SEED=
SYNTHETIC_OUTPUT_DIR=

# --- Observability (PHASE 16: audit logging + pipeline metrics) ---
# Default is <repo>/reports/observability (events.jsonl). Override to relocate
# the structured audit log; also enables dbt-run event emission without flags.
MRI_OBSERVABILITY_DIR=
# Set to "1" to also print canonical JSON lines to stderr (stdout stays clean).
MRI_JSON_LOG_CONSOLE=

# --- Prometheus + Grafana (PHASE 19: optional `observability` compose profile) ---
# Only used when the optional monitoring overlay is started with the
# `observability` profile; the core stack never requires any of these.
# Host ports for the exporter, Prometheus and Grafana UIs.
METRICS_PORT=
PROMETHEUS_PORT=
GRAFANA_PORT=
# Grafana admin account (both REQUIRED when the `observability` profile is used;
# no insecure admin/admin default is wired — validation fails if unset).
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=


# --- CI / misc ---
LOG_LEVEL=
