# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments ---
.venv/
venv/
ENV/
env/
.virtualenv/

# --- uv ---
# uv.lock is intentionally committed (reproducible dependency resolution)

# --- pytest / coverage / testing ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
.tox/
.nox/

# --- Playwright browser E2E artifacts (screenshots) ---
e2e/artifacts/

# --- Ruff / mypy ---
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# --- Jupyter ---
.ipynb_checkpoints/

# --- IDE / editor ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Environment / secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json
secrets/
*.p12
*.pfx

# --- Docker local artifacts ---
docker/data/
docker/volumes/
**/pgdata/
*.log

# --- Generated data (not source) ---
# (leading-slash patterns keep the directories rule re-includable for .gitkeep)
/data/*
!/data/.gitkeep
/datasets/
/generated/
/reports/
/output/
/tmp/
/temp/
/.cache/

# --- Logs ---
/logs/*
!/logs/.gitkeep
*.log

# --- Airflow / dbt local artifacts (created in later phases) ---
dags/__pycache__/
logs/airflow/
/airflow/logs/*
!/airflow/logs/.gitkeep
/airflow/config/
plugins/
airflow.db
airflow.cfg
dbt_target/
target/
dbt_packages/
logs/dbt/
dbt/logs/
dbt/.user.yml
