# Morocco Retail Intelligence — Prometheus metrics exporter image (PHASE 19).
#
# Deliberately minimal. The exporter is hand-rolled Prometheus text exposition
# (see src/mri/metrics/) and only needs psycopg to read the existing ops audit
# views, PostgreSQL health statistics and the Airflow metadata database. No
# web framework, no prometheus-client. The image therefore stays tiny and has
# no build-time coupling to the rest of the project.
#
# Build context is the repository root (see docker-compose.observability.yml).

FROM python:3.12.13-slim-bookworm

# psycopg[binary] matches the version locked in uv.lock / pyproject.toml.
RUN pip install --no-cache-dir "psycopg[binary]==3.3.6"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MRI_METRICS_HOST=0.0.0.0 \
    MRI_METRICS_PORT=9245

WORKDIR /app

# Only the shared package marker and the metrics subpackage are copied; the
# exporter must never import the heavier ingestion modules.
COPY src/mri/__init__.py /app/mri/__init__.py
COPY src/mri/metrics/ /app/mri/metrics/

RUN chown -R 65534:65534 /app

USER 65534:65534

EXPOSE 9245

CMD ["python", "-m", "mri.metrics"]
